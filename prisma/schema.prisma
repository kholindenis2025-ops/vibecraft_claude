// Prisma schema for VIBECRAFT — Vibe Coding: от нуля до про

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  CURATOR
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModuleCategory {
  INTRO
  MODULE
  TOOL
  BONUS
  MATERIAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  emailVerified              Boolean   @default(false)
  verificationCodeHash       String?
  verificationCodeExpiresAt  DateTime?
  verificationCodeSentAt     DateTime?
  verificationAttempts       Int       @default(0)

  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  submissions       HomeworkSubmission[] @relation("StudentSubmissions")
  reviewedByAdmin   HomeworkSubmission[] @relation("ReviewerSubmissions")
  achievements      UserAchievement[]
  notificationReads NotificationRead[]
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  href      String
  createdAt DateTime @default(now())

  reads NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([userId, notificationId])
}

model Module {
  id          String         @id @default(cuid())
  slug        String         @unique
  order       Int
  category    ModuleCategory @default(MODULE)
  title       String
  description String
  icon        String         @default("compass")
  externalUrl String?
  toolKey     String?
  createdAt   DateTime       @default(now())

  lessons Lesson[]
  quiz    Quiz?
}

model Lesson {
  id          String  @id @default(cuid())
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  slug        String
  title       String
  summary     String  @default("")
  content     String  @default("")
  durationMin Int     @default(10)
  format      String?
  availableFrom DateTime?
  contentUpdatedAt DateTime?

  progress  LessonProgress[]
  homework  Homework?
  terms     LessonTerm[]
  resources LessonResource[]
  videos    LessonVideo[]
  slides    LessonSlide[]
  materials LessonMaterial[]

  @@unique([moduleId, slug])
}

model LessonMaterial {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  title    String?
  url      String

  @@unique([lessonId, order])
}

model LessonVideo {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  title    String?
  url      String

  @@unique([lessonId, order])
}

model LessonSlide {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  title    String?
  url      String

  @@unique([lessonId, order])
}

model LessonResource {
  id       String @id @default(cuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order    Int
  title    String
  url      String

  @@unique([lessonId, order])
}

model LessonTerm {
  id         String @id @default(cuid())
  lessonId   String
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order      Int
  term       String
  definition String

  @@unique([lessonId, order])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model Quiz {
  id       String @id @default(cuid())
  moduleId String @unique
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String @default("Проверь себя")
  passScore Int   @default(70)

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id      String @id @default(cuid())
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order   Int
  text    String
  options String // JSON-encoded string[]
  correctIndex Int
  explanation String @default("")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  answers   String // JSON-encoded number[]
  createdAt DateTime @default(now())
}

model Homework {
  id          String @id @default(cuid())
  lessonId    String @unique
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String

  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id           String           @id @default(cuid())
  homeworkId   String
  homework     Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  answerText   String
  answerUrl    String?
  status       SubmissionStatus @default(PENDING)
  feedback     String?
  reviewedById String?
  reviewedBy   User?            @relation("ReviewerSubmissions", fields: [reviewedById], references: [id])
  createdAt    DateTime         @default(now())
  reviewedAt   DateTime?
  files        HomeworkSubmissionFile[]
}

model HomeworkSubmissionFile {
  id           String             @id @default(cuid())
  submissionId String
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  url          String
  size         Int
  createdAt    DateTime           @default(now())
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String @default("trophy")

  users UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}
