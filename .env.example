# Скопируйте этот файл в .env и заполните реальными значениями.
# Оба значения ниже берутся из Neon (Vercel → Storage → ваша Postgres-база → Connect).

# "Pooled connection" — используется приложением в рантайме (через PgBouncer)
DATABASE_URL="postgresql://user:password@ep-xxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# "Direct connection" — используется только для миграций (prisma migrate)
DIRECT_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require"

# Секрет для подписи сессионных JWT. Сгенерировать: openssl rand -hex 32
AUTH_SECRET="замените-на-случайную-строку-минимум-32-символа"

# Хранилище файлов домашних заданий (Vercel → Storage → Create Database → Blob).
# После создания Vercel сам добавит эту переменную в Production env — руками
# заполнять нужно только для локальной разработки.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
